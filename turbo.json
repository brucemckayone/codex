{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [
    "config/vite/**",
    "config/tsconfig/**",
    "tsconfig.json",
    "config/vitest/**",
    "vitest.setup.ts",
    ".github/workflows/testing.yml",
    ".github/scripts/start-local-neon-proxy.sh"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".svelte-kit/**", "build/**"],
      "cache": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": ["coverage/**"],
      "env": [
        "DB_METHOD",
        "NODE_ENV",
        "CI",
        "R2_ACCOUNT_ID",
        "R2_ACCESS_KEY_ID",
        "R2_SECRET_ACCESS_KEY",
        "R2_BUCKET_MEDIA",
        "R2_BUCKET_ASSETS",
        "R2_BUCKET_RESOURCES",
        "R2_BUCKET_PLATFORM"
      ],
      "passThroughEnv": [
        "DATABASE_URL",
        "DATABASE_URL_LOCAL_PROXY",
        "NEON_API_KEY",
        "NEON_PROJECT_ID",
        "NEON_PARENT_BRANCH_ID"
      ]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["DATABASE_URL", "DB_METHOD", "PLAYWRIGHT_BASE_URL", "CI"],
      "passThroughEnv": ["DATABASE_URL_LOCAL_PROXY"]
    },
    "test:e2e:ui": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "cache": true
    },
    "format": {
      "cache": true
    },
    "format:check": {
      "cache": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "cache": true
    },
    "check": {
      "cache": true
    }
  }
}
