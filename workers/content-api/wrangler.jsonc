{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "content-api",
  // Public exposure: OFF by default (Codex-kgrdp.12). With this unset,
  // Cloudflare defaults BOTH the workers.dev route and the preview URL to
  // ENABLED for any deploy that has no `routes` — which is how 8 orphaned *-dev
  // workers ended up answering the public internet and absorbing a credential
  // scanner (~6,275 requests in 24 minutes on auth-worker-dev, 2026-08-26). KV
  // quota is billed per ACCOUNT, so that traffic burned production's daily
  // write allowance. Envs that declare `routes` already infer false; being
  // explicit here means a future env that forgets its routes fails closed
  // instead of open. MUST live in config: disabling it only in the dashboard is
  // silently re-enabled by the next `wrangler deploy`.
  "workers_dev": false,
  "main": "dist/index.js",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],


  // Observability configuration
  "observability": {
    "enabled": true
  },

  // Rate limiting — native Workers Rate Limiting bindings (kgrdp.17 / .9).
  //
  // `streaming` backs the raw HLS proxy routes (src/routes/content-access.ts).
  // `strict` and `api` back the presets this worker's procedure() routes
  // declare — and `api` is also the default procedure() applies where a route
  // declares nothing, so it is reachable from every route here. Without a
  // binding the limiter fails OPEN and logs `rate_limit.fail_open` at error
  // level on EVERY request.
  //
  // `simple.limit` / `simple.period` MUST match RATE_LIMIT_PRESETS in
  // packages/constants/src/limits.ts. The binding, not that file, is what the
  // runtime enforces, and nothing checks that the two agree at deploy time.
  // `period` may only be 10 or 60.
  //
  // namespace_id is PER WORKER AND PER ENV, not per preset: bindings sharing an
  // id share counters across the whole ACCOUNT. A preset-wide id would let one
  // worker's traffic spend another's budget (and a browser action that fans out
  // to several workers would 429 at a fraction of the nominal rate); an
  // env-wide id would let E2E traffic in content-api-test spend
  // content-api-production's. That account-wide coupling is what let a dev
  // worker burn production's KV quota in the first place.
  //
  // Scheme: env digit (1 dev, 2 test, 3 production) + two-digit worker number
  // from CLAUDE.md + preset digit (1 strict, 2 streaming, 3 api, 4 web).
  // content-api is worker 2, so streaming is 1022 / 2022 / 3022.
  "ratelimits": [
    {
      "name": "RATE_LIMIT_STRICT",
      "namespace_id": "1021",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "RATE_LIMIT_STREAMING",
      "namespace_id": "1022",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "RATE_LIMIT_API",
      "namespace_id": "1023",
      "simple": {
        "limit": 100,
        "period": 60
      }
    }
  ],

  // KV Namespaces
  //
  "kv_namespaces": [
    {
      "binding": "AUTH_SESSION_KV",
      "id": "82d04a4236df4aac8e9d87793344f0ed"
    },
    {
      // Was c5e85d4c8ecb46f9a3e5d4d96a14e9f1, a namespace that does not exist
      // in the account (Codex-kgrdp.21): every `wrangler deploy` of the default
      // env failed on it, and only production escaped because it overrides
      // CACHE_KV per-env. 8bde7d718cff4bfa99e29cd8e0aa7353 is the real dev/test
      // CACHE_KV — the id apps/web's test env was already using.
      "binding": "CACHE_KV",
      "id": "8bde7d718cff4bfa99e29cd8e0aa7353"
    }
  ],

  // R2 Buckets
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "codex-media-production",
      "preview_bucket_name": "codex-media-test"
    },
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "codex-assets-production",
      "preview_bucket_name": "codex-assets-test"
    }
  ],

  // Default environment variables (local development)
  "vars": {
    "ENVIRONMENT": "development",
    "DB_METHOD": "LOCAL_PROXY",
    "WEB_APP_URL": "http://lvh.me:3000",
    "API_URL": "http://localhost:8787",
    "MEDIA_API_URL": "http://localhost:4002",
    "R2_PUBLIC_URL_BASE": "http://localhost:4100"
  },

  // Environment configurations
  "env": {
    // Test environment (E2E tests) Note: DB_METHOD is set via .dev.vars.test
    // (NEON_BRANCH in CI, LOCAL_PROXY locally)
    "test": {
      "name": "content-api-test",
      // Bindings are not inherited into a named env — see the default env.
      "ratelimits": [
        {
          "name": "RATE_LIMIT_STRICT",
          "namespace_id": "2021",
          "simple": {
            "limit": 20,
            "period": 60
          }
        },
        {
          "name": "RATE_LIMIT_STREAMING",
          "namespace_id": "2022",
          "simple": {
            "limit": 60,
            "period": 60
          }
        },
        {
          "name": "RATE_LIMIT_API",
          "namespace_id": "2023",
          "simple": {
            "limit": 100,
            "period": 60
          }
        }
      ],
      "vars": {
        "ENVIRONMENT": "test",
        "DB_METHOD": "LOCAL_PROXY",
        "WEB_APP_URL": "http://lvh.me:3000",
        "API_URL": "http://localhost:8787",
        "MEDIA_API_URL": "http://localhost:4002",
        "R2_PUBLIC_URL_BASE": "http://localhost:4100"
      },
      "kv_namespaces": [
        {
          "binding": "AUTH_SESSION_KV",
          "id": "82d04a4236df4aac8e9d87793344f0ed"
        },
        {
          // See the default-env CACHE_KV note above.
          "binding": "CACHE_KV",
          "id": "8bde7d718cff4bfa99e29cd8e0aa7353"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "codex-media-production",
          "preview_bucket_name": "codex-media-test"
        },
        {
          "binding": "ASSETS_BUCKET",
          "bucket_name": "codex-assets-production",
          "preview_bucket_name": "codex-assets-test"
        }
      ]
    },

    // Production environment
    "production": {
      "name": "content-api-production",
      // Bindings are not inherited into a named env — see the default env.
      "ratelimits": [
        {
          "name": "RATE_LIMIT_STRICT",
          "namespace_id": "3021",
          "simple": {
            "limit": 20,
            "period": 60
          }
        },
        {
          "name": "RATE_LIMIT_STREAMING",
          "namespace_id": "3022",
          "simple": {
            "limit": 60,
            "period": 60
          }
        },
        {
          "name": "RATE_LIMIT_API",
          "namespace_id": "3023",
          "simple": {
            "limit": 100,
            "period": 60
          }
        }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "DB_METHOD": "PRODUCTION",
        "WEB_APP_URL": "https://revelations.studio",
        // No API_URL override here: buildServiceUrl uses API_URL as the
        // override key for the content/access services, and a stale
        // api.revelations.studio (dead host) would beat the correct ENV_HOSTS
        // default (content-api.revelations.studio).
        "MEDIA_API_URL": "https://media-api.revelations.studio",
        // Public R2 asset host (thumbnails, logos). MUST match the provisioned
        // R2 custom domain in .github/config/r2-infrastructure.json (assets
        // bucket → cdn-assets.revelations.studio). `cdn.revelations.studio` is
        // unprovisioned, so every thumbnail/logo/public image 404'd.
        "R2_PUBLIC_URL_BASE": "https://cdn-assets.revelations.studio"
      },
      "kv_namespaces": [
        {
          "binding": "AUTH_SESSION_KV",
          "id": "aab4025dcb5c44ad8d1156bcfda055d2"
        },
        {
          "binding": "CACHE_KV",
          "id": "499d67770dc2405ab80cba5629b16511"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "codex-media-production"
        },
        {
          "binding": "ASSETS_BUCKET",
          "bucket_name": "codex-assets-production"
        }
      ],
      "routes": [
        {
          "pattern": "content-api.revelations.studio",
          "custom_domain": true
        }
      ]
    }
  }

  // ==========================================================================
  // Environment Variables & Secrets
  // ==========================================================================
  //
  // Local Development:
  //   Create .dev.vars file with required secrets (see .dev.vars.example)
  //
  // Test Environment:
  //   Uses .dev.vars.test (already configured with test values)
  //
  // Production Secrets (set via wrangler CLI):
  //   wrangler secret put DATABASE_URL --env production
  //   wrangler secret put R2_ACCOUNT_ID --env production
  //   wrangler secret put R2_ACCESS_KEY_ID --env production
  //   wrangler secret put R2_SECRET_ACCESS_KEY --env production
  //   wrangler secret put R2_BUCKET_MEDIA --env production
  //
  // Required Variables:
  //   - DATABASE_URL: PostgreSQL connection string
  //   - R2_ACCOUNT_ID: Cloudflare R2 account ID
  //   - R2_ACCESS_KEY_ID: R2 access key ID
  //   - R2_SECRET_ACCESS_KEY: R2 secret access key
  //   - R2_BUCKET_MEDIA: R2 bucket name for media storage
  //
  // Cache Purge Secrets (set via wrangler CLI):
  //   wrangler secret put CF_ZONE_ID --env production
  //   wrangler secret put CF_API_TOKEN --env production
}
