{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "admin-api",
  // Public exposure: OFF by default (Codex-kgrdp.12).
  // With this unset, Cloudflare defaults BOTH the workers.dev route and the
  // preview URL to ENABLED for any deploy that has no `routes` — which is how
  // 8 orphaned *-dev workers ended up answering the public internet and
  // absorbing a credential scanner (~6,275 requests in 24 minutes on
  // auth-worker-dev, 2026-08-26). KV quota is billed per ACCOUNT, so that
  // traffic burned production's daily write allowance.
  // Envs that declare `routes` already infer false; being explicit here means
  // a future env that forgets its routes fails closed instead of open.
  // MUST live in config: disabling it only in the dashboard is silently
  // re-enabled by the next `wrangler deploy`.
  "workers_dev": false,
  "main": "dist/index.js",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],

  // Observability configuration
  "observability": {
    "enabled": true
  },

  // KV Namespaces
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT_KV",
      "id": "cea7153364974737b16870df08f31083"
    },
    {
      "binding": "AUTH_SESSION_KV",
      "id": "82d04a4236df4aac8e9d87793344f0ed"
    },
    {
      "binding": "CACHE_KV",
      "id": "c5e85d4c8ecb46f9a3e5d4d96a14e9f1"
    }
  ],

  // R2 Buckets (for logo uploads)
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "codex-media-production",
      "preview_bucket_name": "codex-media-test"
    },
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "codex-assets-production",
      "preview_bucket_name": "codex-assets-test"
    }
  ],

  // Default environment variables (local development)
  "vars": {
    "ENVIRONMENT": "development",
    "DB_METHOD": "LOCAL_PROXY",
    "WEB_APP_URL": "http://lvh.me:3000", "API_URL": "http://localhost:8787"
  },

  // Environment configurations
  "env": {
    // Test environment (E2E tests)
    // Note: DB_METHOD is set via .dev.vars.test (NEON_BRANCH in CI, LOCAL_PROXY locally)
    "test": {
      "name": "admin-api-test",
      "vars": {
        "ENVIRONMENT": "test",
        "DB_METHOD": "LOCAL_PROXY",
        "WEB_APP_URL": "http://lvh.me:3000",
        "API_URL": "http://localhost:8787"
      },
      "kv_namespaces": [
        {
          "binding": "RATE_LIMIT_KV",
          "id": "cea7153364974737b16870df08f31083"
        },
        {
          "binding": "AUTH_SESSION_KV",
          "id": "82d04a4236df4aac8e9d87793344f0ed"
        },
        {
          "binding": "CACHE_KV",
          "id": "c5e85d4c8ecb46f9a3e5d4d96a14e9f1"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "codex-media-test"
        },
        {
          "binding": "ASSETS_BUCKET",
          "bucket_name": "codex-assets-test"
        }
      ]
    },

    // Production environment
    "production": {
      "name": "admin-api-production",
      "vars": {
        "ENVIRONMENT": "production",
        "DB_METHOD": "PRODUCTION",
        "WEB_APP_URL": "https://revelations.studio",
        "AUTH_WORKER_URL": "https://auth.revelations.studio"
      },
      "kv_namespaces": [
        {
          "binding": "RATE_LIMIT_KV",
          "id": "06b7205ce78042ca9cad7b7e582ddf21"
        },
        {
          "binding": "AUTH_SESSION_KV",
          "id": "aab4025dcb5c44ad8d1156bcfda055d2"
        },
        {
          "binding": "CACHE_KV",
          "id": "499d67770dc2405ab80cba5629b16511"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "codex-media-production"
        },
        {
          "binding": "ASSETS_BUCKET",
          "bucket_name": "codex-assets-production"
        }
      ],
      "routes": [
        {
          "pattern": "admin-api.revelations.studio",
          "custom_domain": true
        }
      ]
    }
  }

  // ==========================================================================
  // Environment Variables & Secrets
  // ==========================================================================
  //
  // Local Development:
  //   Create .dev.vars file with required secrets (see .dev.vars.example)
  //
  // Test Environment:
  //   Uses .dev.vars.test (already configured with test values)
  //
  // Production Secrets (set via wrangler CLI):
  //   wrangler secret put DATABASE_URL --env production
  //
  // Required Variables:
  //   - DATABASE_URL: PostgreSQL connection string
  //   - RATE_LIMIT_KV: KV namespace binding (configured above)
}
