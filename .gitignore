# Environment variables
.env
.env.*
**/.env
**/.env.*

# Vite temp files
**/vite.config.ts.timestamp-*.mjs
.dev.vars
.dev.vars.*
**/.dev.vars
**/.dev.vars.*
# ...but the placeholder templates ARE the documentation for local setup.
# Without these tracked, a working local config only ever exists on one machine
# (which is how local transcoding silently rotted — see infrastructure/runpod/LOCAL_DEV.md).
!**/.dev.vars.example
env.dev
env.prod

# GitHub environment config files (contain secrets!)
.github/env/.env.github.*

# Dependencies
node_modules

# Image assets (if not part of the source)
*.png
# ...but PWA/favicon icons in the web app's static dir ARE source assets and
# must be committed (SvelteKit serves them; otherwise /icon-192.png etc. 404).
!apps/web/static/*.png

# Act (GitHub Actions local testing)
.secrets
.actrc.local

# Coverage reports
coverage/
**/coverage/
**/.wrangler/
.svelte-kit/

# Turborepo
.turbo

# Biome
.biome-cache/

# Seed image cache
.cache/

# IDE settings
.vscode/

# Test results
**/test-results/

# Build output
**/dist/
# TypeScript compiled output (should only be in dist/)
packages/**/*.js
packages/**/*.js.map
!packages/**/test-client.js
!packages/validation/src/*.js

# OS-specific
.DS_Store

# Log files
*.log

# Beads local database and temp files
.beads/*.db
.beads/*.db-shm
.beads/*.db-wal
.beads/bd.sock
.beads/bd.sock.*
.beads/daemon.*
.beads/last-touched

# Claude Code agent worktrees (never commit these — they're nested git checkouts)
.claude/worktrees/

# Playwright MCP snapshots
.playwright-mcp/

# Stripe MCP skills (auto-generated symlinks)
#
# ANCHORED to the repo root, and `.pi/skills/` listed explicitly. This used to
# be a bare `skills/`, which git matches at ANY depth — so it also swallowed
# `.claude/skills/`. Sixteen skills there stayed tracked only because they
# predate the rule (git keeps already-tracked files regardless of ignores),
# while `denoise` and `triage` were invisible to every review.
#
# That is not cosmetic: `denoise/SKILL.md` and its audit agents GENERATE repo
# content — they instructed agents to write `.skip`ped proof tests under
# `packages/*/src/__denoise_proofs__/`. The user retired that pattern on
# 2026-05-17, but because the instruction could not be reviewed it kept
# regenerating the artefact; 54 files were still on `dev` months later, two
# created as recently as 2026-09-02. A generator on an ignored path cannot be
# fixed by a PR.
/skills/
skills-lock.json
.agents/skills/stripe-*
.agents/skills/upgrade-*

# Agent IDE skill symlinks (auto-generated by Stripe MCP)
.adal/
.augment/
.bob/
.codebuddy/
.commandcode/
.continue/
.cortex/
.crush/
.factory/
.goose/
.iflow/
.junie/
.kilocode/
.kiro/
.kode/
.mcpjam/
.mux/
.neovate/
.openhands/
.pi/
.pochi/
.qoder/
.qwen/
.roo/
.trae/
.vibe/
.windsurf/
.zencoder/

# Fallow incremental cache (per-workspace)
.fallow/
**/.fallow/

# Backfill script checkpoints + needs-review logs (one-shot scripts only)
packages/database/.backfill/

# Local-only shader verification scripts
apps/web/.*-shot.mjs

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
